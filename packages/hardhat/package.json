{
  "name": "@stickrnet/hardhat",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@nomicfoundation/hardhat-verify": "^2.0.11",
    "@nomiclabs/hardhat-etherscan": "^3.1.7",
    "@openzeppelin/contracts": "^4.8.0",
    "axios": "^1.3.2",
    "dotenv": "^16.0.3",
    "hardhat": "2.19.5",
    "solmate": "^6.8.0"
  },
  "scripts": {
    "contracts:compile": "hardhat compile --force",
    "deploy": "hardhat run ./scripts/deploy.js --network baseSepolia",
    "test:hardhat": "hardhat test",
    "test:foundry": "forge test --match-path 'foundry/test/unit/*.t.sol'",
    "test:fuzz": "FOUNDRY_PROFILE=ci forge test --match-path 'foundry/test/fuzz/*.t.sol'",
    "test:invariant": "FOUNDRY_PROFILE=ci forge test --match-path 'foundry/test/invariant/*.t.sol'",
    "test:differential": "hardhat run scripts/differential-hardhat.js && forge test --match-contract DifferentialScenarioTest && node scripts/compare-differential.js",
    "test:coverage": "node scripts/hardhat-coverage.js",
    "test:coverage:foundry": "node scripts/foundry-coverage.js",
    "test:gas": "forge snapshot --match-contract GasSnapshotTest --snap foundry/snapshots/gas.snap",
    "verify:contract-equivalence": "hardhat compile --force && forge build --force --skip test --deny-warnings && node scripts/verify-contract-equivalence.js",
    "test:verification": "yarn contracts:compile && yarn test:hardhat && yarn test:foundry && yarn test:fuzz && yarn test:invariant && yarn test:differential && yarn verify:contract-equivalence"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^1.0.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.9",
    "@nomiclabs/hardhat-ethers": "^2.0.5",
    "@nomiclabs/hardhat-waffle": "^2.0.5",
    "chai": "^4.3.6",
    "ethereum-waffle": "^3.4.4",
    "ethers": "^5.6.4",
    "solidity-coverage": "^0.8.15"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
